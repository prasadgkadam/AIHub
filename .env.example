# Copy this file to .env.local values here are only a reference —
# this project reads these as real OS/webserver environment variables,
# not from a .env loader. Set them in your WAMP/Apache config, your
# shell, or your hosting provider's environment settings.

# --- Database ---
DB_HOST=localhost
DB_NAME=aihub
DB_USER=root
DB_PASS=

# --- Gmail SMTP (for OTP / password reset emails) ---
# Create an App Password at:
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
